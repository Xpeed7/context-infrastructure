# AI Heartbeat - runtime env template
# Copy the keys you need into:
# /Users/chenruiyan/2026-project/context-infrastructure/periodic_jobs/ai_heartbeat/.env

# OpenCode Server connection
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=replace-with-your-opencode-basic-auth-password

# Long-running agentic jobs often take much longer than normal API calls.
OPENCODE_MESSAGE_TIMEOUT=3600

# Optional notes:
# 1. Start OpenCode server before using observer / reflector.
# 2. If your server runs on another host or port, update OPENCODE_BASE_URL.
