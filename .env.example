# Context Infrastructure - workspace-level secrets template
# Copy the keys you need into /Users/chenruiyan/2026-project/context-infrastructure/.env
# Do not commit real values.

# --------------------------------------------------------------------
# Semantic Search
# --------------------------------------------------------------------
OPENAI_API_KEY=replace-with-your-openai-api-key

# --------------------------------------------------------------------
# Email notifications via Gmail
# --------------------------------------------------------------------
GMAIL_USERNAME=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=replace-with-your-gmail-app-password
GMAIL_RECIPIENTS=your-email@example.com

# --------------------------------------------------------------------
# Slide generation / Gemini-based workflows
# --------------------------------------------------------------------
GEMINI_API_KEY=replace-with-your-gemini-api-key

# --------------------------------------------------------------------
# Growth analytics
# --------------------------------------------------------------------
KIT_API_KEY=replace-with-your-kit-api-key
TYPEFULLY_API_KEY=replace-with-your-typefully-api-key
GA4_CREDENTIALS_PATH=/absolute/path/to/ga4-service-account.json

# Typefully browser-session credentials
# These are only needed for engagement metrics, not basic publish status.
TYPEFULLY_AUTHORIZATION=replace-with-your-typefully-authorization-token
TYPEFULLY_ACCOUNT=replace-with-your-typefully-account-id
TYPEFULLY_SESSION=replace-with-your-typefully-session-id
TYPEFULLY_COOKIE=
TYPEFULLY_BASE_URL=https://typefully.com
TYPEFULLY_TIMEOUT=30
TYPEFULLY_USER_AGENT=Mozilla/5.0
TYPEFULLY_REFERER=https://typefully.com/grow
